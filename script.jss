body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f4f4;
    color: #333;
}

nav {
    background: #222;
    color: white;
    padding: 20px;
    display: flex;
    gap: 25px;
    align-items: center;
}

nav a {
    color: white;
    text-decoration: none;
}

section {
    padding: 60px;
    text-align: center;
}

#home {
    background: white;
    min-height: 300px;
}

button {
    padding: 12px 25px;
    border: none;
    background: #222;
    color: white;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background: #555;
}
